# VolatilityLab Environment Configuration
# Copy this file to .env and customize as needed

# Application
APP_ENV=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8765
PORT=8000
API_WORKERS=1

# Comma-separated extra CORS origins for hosted frontends (localhost is always allowed).
# CORS_ORIGINS=https://volatility-lab-ui.onrender.com

# Frontend (empty = same-origin /api via Vite proxy)
VITE_API_URL=
FRONTEND_PORT=5175
VITE_PROXY_TARGET=http://127.0.0.1:8765

# Data Storage
DATA_DIR=./data
SNAPSHOTS_DIR=./data/snapshots

# Market Data (optional - defaults to yfinance)
# MARKET_DATA_PROVIDER=yfinance

# Risk-free rate source (default uses constant rate if not specified)
RISK_FREE_RATE=0.045

# Logging
LOG_LEVEL=INFO

# Database (for future use - not required for MVP)
# DATABASE_URL=postgresql://user:password@localhost:5432/volatilitylab

# MLflow (for future use)
# MLFLOW_TRACKING_URI=http://localhost:5000
