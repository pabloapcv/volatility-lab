FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project metadata first (hatchling needs README/LICENSE to build)
COPY pyproject.toml README.md LICENSE ./
COPY src/ src/
COPY backend/ backend/

# Install Python dependencies (ML extras so "Run Experiment" works in Docker)
RUN pip install --no-cache-dir -e ".[ml]"

# Copy sample data for offline use (includes committed yfinance chains + FR-07 JSON)
COPY data/ data/

# Set environment variables
ENV PYTHONPATH=/app/src:/app
ENV API_HOST=0.0.0.0
ENV API_PORT=8000
ENV PORT=8000

EXPOSE 8000

# Shell form so Render can inject PORT (default 8000 locally).
CMD uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8000}
